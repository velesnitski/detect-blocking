# Local configuration — may contain real endpoint details
detect_blocking.conf

# secret-scan banned-string list — holds REAL infra identifiers (the values are
# themselves the secrets), so it lives only on disk / in CI's SECRET_SCAN_BANNED
# secret, NEVER in the repo. Only scripts/.banned.example (placeholders) is committed.
scripts/.banned

# Local Xray configs used for ad-hoc testing — must NEVER be committed.
.xray-*.json
.xray-*-cfg.json
xray-test-*.json


# Log files
*.log
*.log.[0-9]*

# Temp / OS noise
.DS_Store
*.tmp
*.swp
*~
/tmp/

# Editor / IDE
.vscode/
.idea/
*.iml

# Python bytecode (from test fixtures like tests/fixtures/fake_sub_server.py)
__pycache__/
*.pyc

# Test artefacts
tests/*.out
tests/*.tmp
